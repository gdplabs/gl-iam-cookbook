# Environment. Service B runs PostgreSQLConfig with the third-party provider
# enabled and no encryption_key; PostgreSQLConfig's security validator treats
# an unset ENV as "production" and will fail to start without this.
ENV=development

# Database (shared between Service A and Service B)
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/gliam

# GL-IAM Authentication (shared secret key for token validation)
SECRET_KEY=your-secret-key-min-32-characters-long
DEFAULT_ORGANIZATION_ID=org-123
