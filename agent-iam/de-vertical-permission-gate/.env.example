# Signing key for principal and delegation JWTs.
SECRET_KEY=demo-secret-key-min-32-characters-long!!

# Not connected to. GL-IAM's NativeConfig requires the field, but this example
# only performs stateless JWT work and hands the AgentIdentity in directly,
# so no database session is ever opened.
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/gliam

# Port for the permission console.
PORT=8000
