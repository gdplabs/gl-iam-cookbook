# Keycloak Configuration
KEYCLOAK_SERVER_URL=http://localhost:8080
KEYCLOAK_REALM=gl-iam-demo
KEYCLOAK_CLIENT_ID=glchat-backend
KEYCLOAK_CLIENT_SECRET=glchat-backend-secret

# Agents are registered as Keycloak clients via the Admin API, which requires
# admin credentials. These match KEYCLOAK_ADMIN/_PASSWORD in docker-compose.yml.
KEYCLOAK_ADMIN_USERNAME=admin
KEYCLOAK_ADMIN_PASSWORD=admin

# Signing key for GL-IAM delegation JWTs. Keycloak stores agents (as clients) but
# does not issue delegation tokens, so GL-IAM signs them with this key.
SECRET_KEY=dev-secret-key-min-32-characters-long
