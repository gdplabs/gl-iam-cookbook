# The verifier reads the issuer's public keys from this address at startup.
ISSUER_URL=http://localhost:8000

# Neither service opens a database connection in this example -- every call is
# either stateless JWT work or is handed the AgentIdentity directly. The URL is
# only here because NativeConfig requires one.
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/gliam
