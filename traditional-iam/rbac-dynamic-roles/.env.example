# Database
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/gliam

# Authentication
SECRET_KEY=your-secret-key-min-32-characters-long

# The two tenants this example provisions. Everything in the walkthrough is
# scoped to one of these — that scoping is the point of the example.
TENANT_A_ID=hotel-bali
TENANT_B_ID=hotel-ubud

# Bootstrap accounts created by seed.py
PLATFORM_ADMIN_EMAIL=platform-admin@example.com
PLATFORM_ADMIN_PASSWORD=Platform@dmin1
ORG_ADMIN_PASSWORD=Org@dmin1234
MEMBER_PASSWORD=Member@12345

# Base URL the walkthrough script talks to
API_BASE_URL=http://localhost:8000

# Marks this as a local/dev deployment. Without it, GL-IAM's NativeConfig
# fail-secure validator assumes "production" and rejects the settings above
# (short SECRET_KEY, no ENCRYPTION_KEY). Never set this to "development" in prod.
ENVIRONMENT=development
