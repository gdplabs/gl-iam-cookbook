# Database
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/gliam

# Django
SECRET_KEY=your-secret-key-min-32-characters-long
DEBUG=True

# GL-IAM
DEFAULT_ORGANIZATION_ID=org-123

# Marks this as a local/dev deployment. Without it, GL-IAM's NativeConfig
# fail-secure validator assumes "production" and refuses to start without an
# encryption_key (third-party credentials are encrypted at rest by default).
# Never set this to "development" in prod.
ENVIRONMENT=development
