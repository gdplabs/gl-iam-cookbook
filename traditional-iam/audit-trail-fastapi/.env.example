DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/gliam
SECRET_KEY=your-secret-key-minimum-32-characters-long-here
DEFAULT_ORGANIZATION_ID=default

# Marks this as a local/dev deployment. Without it, GL-IAM's PostgreSQLConfig
# fail-secure validator assumes "production" and enforces stricter checks.
# Never set this to "development" in prod.
ENVIRONMENT=development
