# Stack Auth Configuration
# Cloud: https://api.stack-auth.com   Self-hosted dev: http://localhost:8102
STACKAUTH_BASE_URL=http://localhost:8102
STACKAUTH_PROJECT_ID=your-project-id
STACKAUTH_PUBLISHABLE_CLIENT_KEY=pck_your_publishable_key
STACKAUTH_SECRET_SERVER_KEY=ssk_your_secret_key

# Public URL of this FastAPI app. The Google callback is APP_BASE_URL/auth/google/callback,
# and its domain must be trusted in Stack Auth (Dashboard -> Domains).
APP_BASE_URL=http://localhost:8000
