# Database
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/gliam

# Authentication
SECRET_KEY=your-secret-key-min-32-characters-long
DEFAULT_ORGANIZATION_ID=org-123

# Third-party integration encryption key
# Generate with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
ENCRYPTION_KEY=your-fernet-encryption-key-here

# Marks this as a local/dev deployment. Without it, GL-IAM's PostgreSQLConfig
# fail-secure validator assumes "production" and enforces stricter checks
# (e.g. rejecting a short/default SECRET_KEY). Never set this to
# "development" in prod.
ENVIRONMENT=development
