{
  "id": "dpop-lab",
  "realm": "dpop-lab",
  "displayName": "DPoP Lab",
  "enabled": true,
  "clients": [
    {
      "clientId": "lab-client",
      "name": "Baseline Bearer Client",
      "protocol": "openid-connect",
      "publicClient": false,
      "secret": "lab-secret",
      "standardFlowEnabled": true,
      "directAccessGrantsEnabled": true,
      "serviceAccountsEnabled": true,
      "clientAuthenticatorType": "client-secret"
    },
    {
      "clientId": "dpop-client",
      "name": "DPoP-bound Client",
      "protocol": "openid-connect",
      "publicClient": false,
      "secret": "dpop-secret",
      "standardFlowEnabled": false,
      "directAccessGrantsEnabled": false,
      "serviceAccountsEnabled": true,
      "clientAuthenticatorType": "client-secret",
      "attributes": {
        "dpop.bound.access.tokens": "true"
      }
    },
    {
      "clientId": "mtls-client",
      "name": "mTLS-bound Client",
      "protocol": "openid-connect",
      "publicClient": false,
      "secret": "mtls-secret",
      "standardFlowEnabled": false,
      "directAccessGrantsEnabled": false,
      "serviceAccountsEnabled": true,
      "clientAuthenticatorType": "client-secret",
      "attributes": {
        "tls.client.certificate.bound.access.tokens": "true"
      }
    },
    {
      "clientId": "combined-client",
      "name": "mTLS-authenticated DPoP Client",
      "protocol": "openid-connect",
      "publicClient": false,
      "standardFlowEnabled": false,
      "directAccessGrantsEnabled": false,
      "serviceAccountsEnabled": true,
      "clientAuthenticatorType": "client-x509",
      "attributes": {
        "dpop.bound.access.tokens": "true",
        "x509.subjectdn": "CN=lab-client",
        "x509.casubjectdn": "CN=lab-ca"
      }
    }
  ],
  "users": [
    {
      "username": "lab-user",
      "enabled": true,
      "emailVerified": true,
      "credentials": [
        {
          "type": "password",
          "value": "lab-pass",
          "temporary": false
        }
      ]
    }
  ]
}
